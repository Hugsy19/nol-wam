{
  "manifest_version": 3,
  "name": "NOL Scout — NOL World 回流票监控助手",
  "version": "0.8.2",
  "description": "NOL World 选座助手：本地文字验证码识别、按偏好查找座位、可选自动锁票与结果确认。",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "offscreen",
    "tabs"
  ],
  "host_permissions": [
    "https://world.nol.com/*",
    "https://tickets.interpark.com/*",
    "https://api-ticketfront.interpark.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "NOL Scout",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://world.nol.com/*"
      ],
      "js": [
        "content/product-page.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://tickets.interpark.com/onestop*"
      ],
      "js": [
        "content/onestop-hook.js",
        "content/page-automation.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://tickets.interpark.com/onestop*"
      ],
      "js": [
        "content/seat-bundle.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
